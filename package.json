{
  "name": "zanora-movies-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for Zanora Movies",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zanora.movies",
    "productName": "Zanora Movies",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "zanora-logo-app.png",
      "package.json"
    ],
    "publish": {
      "provider": "github"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "zanora-logo-app.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
