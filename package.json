{
  "name": "zanora-movies-desktop",
  "version": "1.0.4",
  "description": "Desktop wrapper for Zanora Movies",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/cleanDist.js",
    "build": "electron-builder --win --x64",
    "dist": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zanora.movies",
    "productName": "Zanora Movies",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "zanora-logo-app.png",
      "Assets/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "kiwuna",
      "repo": "zanora-app",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "zanora-logo-app.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
